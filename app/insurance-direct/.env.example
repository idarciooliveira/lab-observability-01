# Copy to .env and fill in: cp .env.example .env
# OTEL_TOKEN must match the instance credential in observability-platform/.env
# (the platform gateway authenticates this instance and derives tenant/project
# from it).
# Single database variable for the API. Format:
# postgresql://user:password@postgres:5432/db
# user/password/db must match the postgres service init vars in docker-compose.yml
# (POSTGRES_* defaults/overrides).
DATABASE_URL=postgresql://insurance_user:change-me@postgres:5432/insurance_db
INSURANCE_API_PORT=8083
POSTGRES_PORT=5433
ENV=dev

# Platform ingest: compose.local.yml gateway via Docker internal (OTLP/HTTP only).
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
OTEL_TOKEN=change-me-otel-token

# Fault injection (in-process risk check). 0/0 = off.
# CHAOS_REJECT_RATE is a 0.0-1.0 fraction (0.1 = 10%). Values >1 are read as percent.
CHAOS_LATENCY_MS=0
CHAOS_REJECT_RATE=0

# Web UI (Vite build served by nginx) + browser CORS allowlist.
WEB_PORT=5173
VITE_INSURANCE_API_URL=http://localhost:8083
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
