# Copy to .env and fill in: cp .env.example .env
# TENANT_ID must match a tenant credential the core gateway knows
# (ADR-007: gateway resolves Bearer -> X-Scope-OrgID).
TENANT_ID=tenant-a
ENV=dev
OTEL_TOKEN=change-me-otel-token

# Core ingest (Traefik -> NGINX/OpenResty gateway), HTTPS per docs §2.
CORE_GATEWAY_ENDPOINT=https://host.docker.internal/otlp
CORE_PROM_ENDPOINT=https://host.docker.internal/prometheus/api/v1/write
CORE_LOKI_ENDPOINT=https://host.docker.internal/loki/api/v1/push

# Dev-only while core TLS is self-signed/mkcert (docs §7).
GATEWAY_TLS_INSECURE_SKIP_VERIFY=true

ALLOY_OTLP_GRPC_PORT=4317
ALLOY_OTLP_HTTP_PORT=4318
ALLOY_UI_PORT=12345
BLACKBOX_PORT=9115
